  {"id": "tetrahexyldecyl-ascorbate", "inci": "Tetrahexyldecyl Ascorbate", "aliases": ["ascorbyl tetraisopalmitate"], "functions": ["antioxidant"], "description": "An oil-soluble vitamin C derivative.", "tags": ["vitamin-c-derivative"], "sources": ["cosing"]},
  {"id": "ascorbyl-palmitate", "inci": "Ascorbyl Palmitate", "aliases": [], "functions": ["antioxidant"], "description": "An oil-soluble vitamin C ester, often used to protect the formula from oxidation.", "tags": ["vitamin-c-derivative"], "sources": ["cosing", "alniaimi-2017"]},
  {"id": "retinol", "inci": "Retinol", "aliases": ["vitamin a"], "functions": ["skin conditioning"], "description": "An over-the-counter retinoid (vitamin A). Can cause dryness, peeling and sun sensitivity, especially when starting; usually used at night.", "tags": ["retinoid", "pregnancy-caution"], "sources": ["aad-retinoid", "dermnet-retinoids"]},
  {"id": "retinal", "inci": "Retinal", "aliases": ["retinaldehyde"], "functions": ["skin conditioning"], "description": "Retinaldehyde, a retinoid closely related to retinol. Similar cautions about irritation and sun sensitivity apply.", "tags": ["retinoid", "pregnancy-caution"], "sources": ["dermnet-retinoids"]},
  {"id": "retinyl-palmitate", "inci": "Retinyl Palmitate", "aliases": ["retinyl acetate", "retinyl propionate"], "functions": ["skin conditioning"], "description": "A retinyl ester, a milder form of vitamin A. Counted here as a retinoid to be cautious.", "tags": ["retinoid", "pregnancy-caution"], "sources": ["cosing", "dermnet-retinoids"]},
  {"id": "hydroxypinacolone-retinoate", "inci": "Hydroxypinacolone Retinoate", "aliases": ["hpr", "granactive retinoid"], "functions": ["skin conditioning"], "description": "A retinoid ester sold in cosmetics. Counted here as a retinoid to be cautious.", "tags": ["retinoid", "pregnancy-caution"], "sources": ["cosing", "dermnet-retinoids"]},
