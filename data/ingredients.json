  {"id": "tretinoin", "inci": "Tretinoin", "aliases": ["retinoic acid", "all-trans retinoic acid"], "functions": ["drug: prescription retinoid"], "description": "A prescription retinoid. The most irritating common topical retinoid; it causes sun sensitivity and is broken down by light and by benzoyl peroxide.", "tags": ["retinoid", "pregnancy-caution", "light-sensitive-retinoid"], "sources": ["dermnet-retinoids", "martin-1998"]},
  {"id": "bakuchiol", "inci": "Bakuchiol", "aliases": [], "functions": ["antioxidant", "skin conditioning"], "description": "A plant extract often marketed as a retinol alternative. It is not a retinoid, so retinoid rules are not applied to it.", "tags": [], "sources": ["cosing"]},
