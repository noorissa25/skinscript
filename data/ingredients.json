  {"id": "citric-acid", "inci": "Citric Acid", "aliases": [], "functions": ["ph adjuster", "chelating"], "description": "Usually added in small amounts to set the pH. It is an alpha hydroxy acid, but at pH-adjusting levels this checker does not count it as an exfoliant.", "tags": ["ph-adjuster"], "sources": ["cosing"]},
