  {"id": "ferulic-acid", "inci": "Ferulic Acid", "aliases": [], "functions": ["antioxidant"], "description": "A plant antioxidant often paired with vitamin C to help keep it stable.", "tags": [], "sources": ["cosing", "alniaimi-2017"]},
  {"id": "ascorbic-acid", "inci": "Ascorbic Acid", "aliases": ["l-ascorbic acid", "vitamin c"], "functions": ["antioxidant"], "description": "Pure vitamin C (L-ascorbic acid). An antioxidant that is unstable and breaks down with air and light, so it is usually formulated at low pH with stabilizers.", "tags": ["vitamin-c-laa"], "sources": ["cosing", "alniaimi-2017"]},
  {"id": "sodium-ascorbyl-phosphate", "inci": "Sodium Ascorbyl Phosphate", "aliases": [], "functions": ["antioxidant"], "description": "A vitamin C derivative that is more stable than pure ascorbic acid.", "tags": ["vitamin-c-derivative"], "sources": ["cosing", "alniaimi-2017"]},
  {"id": "magnesium-ascorbyl-phosphate", "inci": "Magnesium Ascorbyl Phosphate", "aliases": [], "functions": ["antioxidant"], "description": "A vitamin C derivative that is more stable than pure ascorbic acid at neutral pH.", "tags": ["vitamin-c-derivative"], "sources": ["cosing", "alniaimi-2017"]},
  {"id": "ascorbyl-glucoside", "inci": "Ascorbyl Glucoside", "aliases": [], "functions": ["antioxidant"], "description": "A vitamin C derivative bound to glucose, more stable than pure ascorbic acid.", "tags": ["vitamin-c-derivative"], "sources": ["cosing"]},
