# Everything here is optional. With nothing set, the checker works fully;
# accounts, saved data and community chat stay switched off.

# AI summaries (server-only secret).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=

# Accounts and community chat (Supabase). The anon key is designed to be public;
# row-level security in supabase/migrations protects every row.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or try everything locally with no backend at all:
# NEXT_PUBLIC_SUPABASE_URL=demo
